% Minimal compatibility fixes for the distributed InfPriv 2026 style.
% Keep the official neurips_infpriv_2026.sty file unchanged.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{infpriv_2026_compat}[2026/10/18 InfPriv style compatibility]
\RequirePackage{etoolbox}
\makeatletter
% The distributed style references \@abstract without defining it.
\providecommand{\@abstract}{}
% Its fixed-height title box otherwise consumes the entire first page.
\patchcmd{\@maketitle}{\vbox to \vsize}{\vbox}{}{%
  \PackageError{infpriv_2026_compat}{Could not patch InfPriv title box}{}%
}
\makeatother
